{
  "name": "pdf-insight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:readme": "node scripts/check-readme-deps.mjs",
    "check:invisible": "node scripts/check-invisible.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:dist && npm run check:secrets && npm run check:readme && npm run check:invisible",
    "smoke": "node scripts/smoke.mjs",
    "deploy:api": "node scripts/deploy-api.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
